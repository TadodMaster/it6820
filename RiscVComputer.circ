    </comp>
    <comp lib="9" loc="(3740,80)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="MEM - Data Memory"/>
    </comp>
    <comp lib="9" loc="(390,2610)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="CPU SINGLE-CYCLE (main) - mỗi lệnh chạy trọn vẹn trong MỘT chu kỳ xung nhịp"/>
    </comp>
    <comp lib="9" loc="(4180,460)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="WBSel: 00 ALU   01 memory   10 PC+4 (JAL/JALR)"/>
    </comp>
    <comp lib="9" loc="(4500,80)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="WB - Write Back"/>
    </comp>
    <comp lib="9" loc="(4510,460)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux chọn giá trị ghi vào rd theo WBSel"/>
    </comp>
    <comp lib="9" loc="(4510,470)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="00 ALU, 01 RAM (load), 10 PC+4 (jal/jalr)"/>
    </comp>
    <comp lib="9" loc="(4510,480)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mỗi loại lệnh lấy kết quả từ nguồn khác nhau"/>
    </comp>
    <comp lib="9" loc="(470,685)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="NOR: PAUSE hoặc is_halt"/>
    </comp>
    <comp lib="9" loc="(470,695)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="clk_en = 1 khi không tạm dừng và chưa tới halt"/>
    </comp>
    <comp lib="9" loc="(470,705)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="PAUSE = 1 hoặc gặp halt thì xung nhịp bị chặn"/>
    </comp>
    <comp lib="9" loc="(510,230)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC register"/>
    </comp>
    <comp lib="9" loc="(520,1870)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="PROBE DỮ LIỆU: các giá trị chạy trong datapath"/>
    </comp>
    <comp lib="9" loc="(530,2080)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="PROBE THANH GHI (tiếp)"/>
    </comp>
    <comp lib="9" loc="(540,1610)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="BẢNG THEO DÕI (probe): xem các giá trị này sau mỗi lần bấm Ctrl+F9"/>
    </comp>
    <comp lib="9" loc="(550,1980)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="PROBE THANH GHI (RegisterFile): giá trị các thanh ghi chương trình mẫu dùng"/>
    </comp>
    <comp lib="9" loc="(560,870)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="DONE = 1: the program reached  halt: j halt  and the clock stopped"/>
    </comp>
    <comp lib="9" loc="(570,1760)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="PROBE ĐIỀU KHIỂN (MainControl): lệnh đang chạy bật những tín hiệu nào"/>
    </comp>
    <comp lib="9" loc="(570,2710)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC kế tiếp: lệnh thường -&gt; PC + 4. branch được rẽ hoặc jal -&gt; PC + hằng số (PC + imm). jalr -&gt; (rs1 + imm) với bit 0 bị xóa (AND 0xFFFFFFFE)."/>
    </comp>
    <comp lib="9" loc="(580,770)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So sánh lệnh hiện tại với 0x6f"/>
    </comp>
    <comp lib="9" loc="(580,780)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 khi PC tới vòng lặp halt: đèn DONE sáng, xung nhịp dừng"/>
    </comp>
    <comp lib="9" loc="(580,790)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Nhờ vậy chạy tự động thì mạch tự dừng, không quay mãi"/>
    </comp>
    <comp lib="9" loc="(595,510)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 4"/>
    </comp>
    <comp lib="9" loc="(595,520)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mỗi lệnh dài 4 byte, PC+4 là lệnh kế tiếp"/>
    </comp>
    <comp lib="9" loc="(596,1072)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x18 | `00002603` | `lw x12, 0(x0)` | nạp lại vào x12 |"/>
    </comp>
    <comp lib="9" loc="(598,1002)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x04 | `00a00593` | `li x11, 10` | x11 = biến đếm = 10 |"/>
    </comp>
    <comp lib="9" loc="(600,1098)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x20 | `40a606b3` | `sub x13, x12, x10` | 110 - 55 = 55 |"/>
    </comp>
    <comp lib="9" loc="(622,989)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x00 | `00000513` | `li x10, 0` | x10 = tổng đang cộng dồn = 0 |"/>
    </comp>
    <comp lib="9" loc="(626,1111)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x24 | `0646a713` | `slti x14, x13, 100` | 55 &lt; 100 nên x14 = 1 |"/>
    </comp>
    <comp lib="9" loc="(630,2640)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="BẢNG VIẾT TẮT: PC = Program Counter (bộ đếm chương trình: địa chỉ lệnh đang chạy). ROM = Read Only Memory (bộ nhớ lệnh chỉ đọc). RAM = bộ nhớ dữ liệu đọc/ghi."/>
    </comp>
    <comp lib="9" loc="(630,80)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="IF - Instruction Fetch"/>
    </comp>
    <comp lib="9" loc="(634,1030)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x0c | `fff58593` | `addi x11, x11, -1` | biến đếm = biến đếm - 1 |"/>
    </comp>
    <comp lib="9" loc="(640,380)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="PC (Program Counter): địa chỉ lệnh đang chạy"/>
    </comp>
    <comp lib="9" loc="(640,390)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Nạp next_pc ở mỗi cạnh xung, RESET đưa về 0"/>
    </comp>
    <comp lib="9" loc="(640,405)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Single-cycle cập nhật PC mỗi chu kỳ"/>
    </comp>
    <comp lib="9" loc="(645,1138)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x2c | `00c60633` | `double: add x12, x12, x12` | x12 = 55 + 55 = 110 |"/>
    </comp>
    <comp lib="9" loc="(648,1016)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x08 | `00b50533` | `loop: add x10, x10, x11` | tổng = tổng + biến đếm |"/>
    </comp>
    <comp lib="9" loc="(650,1890)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="rs1_data: giá trị thanh ghi rs1"/>
    </comp>
    <comp lib="9" loc="(650,1910)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="đọc từ register file"/>
    </comp>
    <comp lib="9" loc="(660,1123)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x28 | `0000006f` | `halt: j halt` | vòng lặp vô hạn: chương trình đã xong |"/>
    </comp>
    <comp lib="9" loc="(660,2110)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="x7: giá trị thanh ghi x7"/>
    </comp>
    <comp lib="9" loc="(660,2130)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(thanh ghi tạm)"/>
    </comp>
    <comp lib="9" loc="(670,2000)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="x1: giá trị thanh ghi x1"/>
    </comp>
    <comp lib="9" loc="(670,2020)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(địa chỉ trả về / giá trị)"/>
    </comp>
    <comp lib="9" loc="(670,2760)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RESET = 1 giữ PC ở 0. Ctrl+F9 = một chu kỳ = một lệnh. Các probe ở trên cho thấy lệnh sắp chạy và kết quả của nó; tab State cho thấy giá trị thanh ghi sau khi lệnh xong."/>
    </comp>
    <comp lib="9" loc="(676,1058)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x14 | `00a02023` | `sw x10, 0(x0)` | lưu tổng (55) vào từ 0 của bộ nhớ dữ liệu |"/>
    </comp>
    <comp lib="9" loc="(677,1152)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x30 | `00008067` | `ret` (= `jalr x0, 0(x1)`) | nhảy về địa chỉ trong x1 (0x20) |"/>
    </comp>
    <comp lib="9" loc="(680,1670)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC: địa chỉ lệnh đang được nạp"/>
    </comp>
    <comp lib="9" loc="(680,1690)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(tăng 4 mỗi chu kỳ, nhảy khi rẽ nhánh)"/>
    </comp>
    <comp lib="9" loc="(690,1790)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RegWrite = 1: lệnh sẽ ghi"/>
    </comp>
    <comp lib="9" loc="(690,1810)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="vào thanh ghi rd"/>
    </comp>
    <comp lib="9" loc="(693,1044)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x10 | `fe059ce3` | `bnez x11, loop` | lặp lại khi biến đếm khác 0 (nhảy lùi 8 byte) |"/>
    </comp>
    <comp lib="9" loc="(695,1085)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="| 0x1c | `010000ef` | `jal x1, double` | gọi hàm ở 0x2c, địa chỉ trả về 0x20 lưu vào x1 |"/>
    </comp>
    <comp lib="9" loc="(720,2685)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RISC-V RV32I = tập lệnh cơ sở 32 bit số nguyên. imm = hằng số trong lệnh. rd/rs1/rs2 = thanh ghi đích/nguồn 1/nguồn 2. funct3/funct7 = trường chọn biến thể lệnh. NOP = không làm gì."/>
    </comp>
    <comp lib="9" loc="(770,2660)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="IF = Instruction Fetch (nạp lệnh). ID = Instruction Decode (giải mã, đọc thanh ghi). EX = Execute (thực thi ở ALU). MEM = Memory access (truy cập RAM). WB = Write Back (ghi kết quả vào thanh ghi)."/>
    </comp>
    <comp lib="9" loc="(810,2735)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp theo lệnh: R (add...) ghi ALU vào rd. I (addi...) dùng imm. load: ALU tính địa chỉ, ghi dữ liệu RAM vào rd. store: ghi rs2 vào RAM. branch: so rs1, rs2. lui/auipc/jal/jalr dùng ASel và WBSel."/>
    </comp>
    <comp lib="9" loc="(820,180)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lấy PC[9:2] làm địa chỉ từ của ROM"/>
    </comp>
    <comp lib="9" loc="(820,190)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh dài 4 byte nên 2 bit thấp luôn 0"/>
    </comp>
    <comp lib="9" loc="(832,918)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chương trình nằm sẵn trong ROM (kiểu Harvard)"/>
    </comp>
    <comp lib="9" loc="(833,934)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ROM lệnh 256 x 32: trả mã máy tại địa chỉ PC"/>
    </comp>
    <comp lib="9" loc="(860,2110)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="x10: giá trị thanh ghi x10"/>
    </comp>
    <comp lib="9" loc="(860,2130)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(tổng cộng dồn (demo))"/>
    </comp>
    <comp lib="9" loc="(860,350)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC[9:2] = word address"/>
    </comp>
    <comp lib="9" loc="(870,2000)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="x2: giá trị thanh ghi x2"/>
    </comp>
    <comp lib="9" loc="(870,2020)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(thanh ghi tạm)"/>
    </comp>
    <comp lib="9" loc="(900,450)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC + 4"/>
    </comp>
    <comp lib="9" loc="(930,1880)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="rs2_data: giá trị thanh ghi rs2"/>
    </comp>
    <comp lib="9" loc="(930,1900)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(cũng là dữ liệu của lệnh store)"/>
    </comp>
    <comp lib="9" loc="(960,1660)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="instr: mã máy 32-bit của lệnh"/>
    </comp>
    <comp lib="9" loc="(960,1680)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="đang thực thi (đọc từ ROM)"/>
    </comp>
    <comp lib="9" loc="(970,1780)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="MemWrite = 1: lệnh store,"/>
    </comp>
    <comp lib="9" loc="(970,1800)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ghi vào RAM dữ liệu"/>
    </comp>
