    </comp>
    <comp lib="9" loc="(1650,570)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ghép thành ForwardA: 10 EX/MEM, 01 MEM/WB, 00 thanh ghi"/>
    </comp>
    <comp lib="9" loc="(1650,585)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux ở EX nhận mã 2 bit"/>
    </comp>
    <comp lib="9" loc="(1650,930)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
