      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Gom RegWrite, WBSel cho tầng WB"/>
    </comp>
    <comp lib="9" loc="(6430,1305)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="WB chỉ cần ghi thanh ghi và chọn kết quả"/>
    </comp>
    <comp lib="9" loc="(6450,250)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="alu_result_wb: thanh ghi MEM/WB (32 bit), lưu kết quả ALU"/>
    </comp>
    <comp lib="9" loc="(6450,260)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chuyển giá trị sang tầng WB ở cạnh xung"/>
    </comp>
    <comp lib="9" loc="(6450,270)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Là địa chỉ load/store hoặc kết quả ghi vào rd, dùng ở tầng sau"/>
    </comp>
    <comp lib="9" loc="(6450,390)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="mem_rdata_wb: thanh ghi MEM/WB (32 bit), lưu dữ liệu đọc từ RAM"/>
    </comp>
    <comp lib="9" loc="(6450,400)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chuyển giá trị sang tầng WB ở cạnh xung"/>
    </comp>
    <comp lib="9" loc="(6450,410)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Dữ liệu load đến WB để ghi vào rd"/>
    </comp>
    <comp lib="9" loc="(6450,540)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="pc_plus4_wb: thanh ghi MEM/WB (32 bit), lưu PC+4 (địa chỉ trả về)"/>
    </comp>
    <comp lib="9" loc="(6450,550)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chuyển giá trị sang tầng WB ở cạnh xung"/>
    </comp>
    <comp lib="9" loc="(6450,560)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Jal/jalr ghi PC+4, nên phải mang nó tới WB"/>
    </comp>
    <comp lib="9" loc="(6450,970)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ctrl_wb: thanh ghi MEM/WB (3 bit), lưu từ điều khiển đóng gói"/>
    </comp>
    <comp lib="9" loc="(6450,980)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chuyển giá trị sang tầng WB ở cạnh xung"/>
    </comp>
    <comp lib="9" loc="(6450,995)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Điều khiển sinh một lần ở ID rồi đi cùng lệnh"/>
    </comp>
    <comp lib="9" loc="(6490,820)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_wb: thanh ghi MEM/WB (5 bit), lưu số thanh ghi đích rd"/>
    </comp>
    <comp lib="9" loc="(6490,830)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chuyển giá trị sang tầng WB ở cạnh xung"/>
    </comp>
    <comp lib="9" loc="(6490,845)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Số thanh ghi đích phải đi cùng lệnh đến WB để ghi đúng chỗ"/>
    </comp>
    <comp lib="9" loc="(6500,140)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="MEM/WB registers"/>
    </comp>
    <comp lib="9" loc="(6640,3140)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RegWrite_wb = 1: lệnh ở WB"/>
    </comp>
    <comp lib="9" loc="(6640,3170)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="sẽ ghi thanh ghi"/>
    </comp>
    <comp lib="9" loc="(6845,510)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 0 (32 bit)"/>
    </comp>
    <comp lib="9" loc="(6845,525)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Dùng làm lệnh rỗng (flush), toán hạng lui, ngả không dùng"/>
    </comp>
    <comp lib="9" loc="(690,3505)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Xem hiệu quả: bấm Ctrl+F9; các hàng probe ở dưới cho thấy stall, pc_src_ex, ForwardA/B và dữ liệu đi qua từng tầng. Chương trình thử hazard: programs/hazards_demo.hex."/>
    </comp>
    <comp lib="9" loc="(6930,280)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Tách từ điều khiển 3 bit ở tầng WB"/>
    </comp>
    <comp lib="9" loc="(6930,290)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="WB chỉ cần RegWrite và WBSel"/>
    </comp>
    <comp lib="9" loc="(6950,250)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="control word of the instruction in WB"/>
    </comp>
    <comp lib="9" loc="(700,3340)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="BẢNG VIẾT TẮT: IF = Instruction Fetch (nạp lệnh), ID = Instruction Decode (giải mã), EX = Execute (thực thi), MEM = Memory access (truy cập RAM), WB = Write Back (ghi lại)."/>
    </comp>
    <comp lib="9" loc="(710,260)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC register (holds while stalled)"/>
    </comp>
    <comp lib="9" loc="(7100,100)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="WB - Write Back"/>
    </comp>
    <comp lib="9" loc="(7100,370)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="WBSel: 00 ALU  01 memory  10 PC+4"/>
    </comp>
    <comp lib="9" loc="(7100,600)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="wb_data goes to the register file (ID) and is also forwarded to EX"/>
    </comp>
    <comp lib="9" loc="(720,3360)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="IF/ID, ID/EX, EX/MEM, MEM/WB = bốn thanh ghi pipeline giữa các tầng, giữ mọi thứ lệnh cần ở tầng sau. Hậu tố _id _ex _mem _wb trong tên dây = tín hiệu của lệnh đang ở tầng đó."/>
    </comp>
    <comp lib="9" loc="(725,1260)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 0 (32 bit)"/>
    </comp>
    <comp lib="9" loc="(725,1270)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Dùng làm lệnh rỗng (flush), toán hạng lui, ngả không dùng"/>
    </comp>
    <comp lib="9" loc="(725,570)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 4"/>
    </comp>
    <comp lib="9" loc="(725,580)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mỗi lệnh dài 4 byte, PC+4 là lệnh kế tiếp"/>
    </comp>
    <comp lib="9" loc="(740,3410)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Hazard dữ liệu: lệnh sau cần giá trị lệnh trước chưa ghi xong -&gt; ForwardingUnit lấy từ EX/MEM (Forward = 10) hoặc MEM/WB (01); riêng load rồi dùng ngay -&gt; HazardUnit stall 1 chu kỳ."/>
    </comp>
    <comp lib="9" loc="(7400,380)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux chọn giá trị ghi vào rd theo WBSel_wb"/>
    </comp>
    <comp lib="9" loc="(7400,390)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="00 ALU, 01 RAM (load), 10 PC+4"/>
    </comp>
    <comp lib="9" loc="(7400,400)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Cũng là nguồn forward từ MEM/WB"/>
    </comp>
    <comp lib="9" loc="(750,3435)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Hazard điều khiển: branch/jal/jalr được quyết định ở EX (pc_src_ex = 1) -&gt; PC nhảy tới đích, hai lệnh đã nạp phía sau bị flush thành bubble: mất 2 chu kỳ. Branch không rẽ: không mất gì."/>
    </comp>
    <comp lib="9" loc="(760,2640)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="BẢNG THEO DÕI (probe): xem các giá trị này sau mỗi lần bấm Ctrl+F9"/>
    </comp>
    <comp lib="9" loc="(760,2860)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="PROBE TẦNG ID VÀ EX (vào): lệnh nào đang ở đâu và nó mang theo gì"/>
    </comp>
    <comp lib="9" loc="(760,3080)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="PROBE TẦNG EX, MEM VÀ WB: dữ liệu đi qua các tầng sau"/>
    </comp>
    <comp lib="9" loc="(810,100)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="IF - Instruction Fetch"/>
    </comp>
    <comp lib="9" loc="(820,3385)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Hazard = xung đột giữa các lệnh đang chạy chồng nhau. Forwarding = chuyển tiếp kết quả về EX. Stall = dừng 1 chu kỳ. Bubble = lệnh rỗng NOP. Flush = hủy các lệnh đã nạp nhầm. CPI = số chu kỳ trên mỗi lệnh."/>
    </comp>
    <comp lib="9" loc="(820,3460)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Từ điều khiển (control word): các tín hiệu điều khiển sinh một lần ở ID, đóng gói rồi đi cùng lệnh qua các thanh ghi pipeline; mỗi tầng tách phần mình cần (13 bit ở ID/EX, 5 bit ở EX/MEM, 3 bit ở MEM/WB)."/>
    </comp>
    <comp lib="9" loc="(890,1000)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="next PC: PC+4, or the branch / jump target from EX"/>
    </comp>
    <comp lib="9" loc="(890,1170)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="a taken branch / jump turns the fetched instruction into a bubble (0)"/>
    </comp>
    <comp lib="9" loc="(890,1440)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="run = not stall: PC and IF/ID only advance when run = 1"/>
    </comp>
    <comp lib="9" loc="(900,2700)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC: địa chỉ đang fetch (đứng yên = stall)"/>
    </comp>
    <comp lib="9" loc="(900,2720)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(nhảy khi pc_src_ex = 1)"/>
    </comp>
    <comp lib="9" loc="(900,2920)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="pc_id: địa chỉ của lệnh"/>
    </comp>
    <comp lib="9" loc="(900,2950)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="đang ở tầng ID"/>
    </comp>
    <comp lib="9" loc="(900,3140)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opA: toán hạng A sau forwarding"/>
    </comp>
    <comp lib="9" loc="(900,3170)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(đã chọn theo ForwardA)"/>
    </comp>
    <comp lib="9" loc="(910,390)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="PC (Program Counter): địa chỉ đang nạp lệnh"/>
    </comp>
    <comp lib="9" loc="(910,400)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Giữ nguyên khi stall (run = 0), RESET đưa về 0"/>
    </comp>
    <comp lib="9" loc="(910,415)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Stall dừng PC để lệnh load-use chờ"/>
    </comp>
