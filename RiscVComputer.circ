    </comp>
    <comp lib="9" loc="(1240,2700)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="instr_id: lệnh đang ở tầng ID"/>
    </comp>
    <comp lib="9" loc="(1240,2720)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(0 = bubble bị flush)"/>
