      <a name="text" val="funct3: 000 beq  001 bne  100 blt  101 bge  110 bltu  111 bgeu"/>
    </comp>
    <comp lib="9" loc="(1470,100)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="000 beq, 001 bne, 100 blt, 101 bge, 110 bltu, 111 bgeu"/>
    </comp>
    <comp lib="9" loc="(1470,110)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Funct3 cho biết lệnh branch nào"/>
    </comp>
    <comp lib="9" loc="(1470,90)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 8:1: chọn điều kiện theo funct3"/>
    </comp>
    <comp lib="9" loc="(1635,215)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="AND: IsBranch và điều kiện"/>
    </comp>
    <comp lib="9" loc="(1635,225)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1: phải rẽ"/>
    </comp>
    <comp lib="9" loc="(1635,240)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh không phải branch không bao giờ rẽ"/>
    </comp>
    <comp lib="9" loc="(360,20)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="BranchUnit"/>
    </comp>
    <comp lib="9" loc="(360,50)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Decides whether a conditional branch is taken: funct3 picks the comparison, IsBranch enables it."/>
    </comp>
    <comp lib="9" loc="(370,525)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Khi branch_taken = 1, PC kế tiếp = PC + hằng số B (xem mạch main / Pipeline)."/>
    </comp>
    <comp lib="9" loc="(400,400)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="ĐƠN VỊ RẼ NHÁNH (BranchUnit) - quyết định lệnh rẽ nhánh có được rẽ không"/>
    </comp>
    <comp lib="9" loc="(520,20)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="unsigned compare"/>
    </comp>
    <comp lib="9" loc="(520,70)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="signed compare"/>
    </comp>
    <comp lib="9" loc="(580,220)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So sánh có dấu: ra '&lt;' có dấu"/>
    </comp>
    <comp lib="9" loc="(580,230)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Blt/bge coi số là có dấu (-1 nhỏ hơn 1)"/>
    </comp>
    <comp lib="9" loc="(590,450)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Vào: rs1_data, rs2_data (hai giá trị cần so), IsBranch (đây có phải lệnh branch), funct3 (chọn phép so). Ra: branch_taken = 1 nếu phải rẽ."/>
    </comp>
    <comp lib="9" loc="(685,70)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="NOT: đảo '=' thành '!='"/>
    </comp>
    <comp lib="9" loc="(685,85)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bne = không bằng"/>
    </comp>
    <comp lib="9" loc="(690,280)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 0: điều kiện 'không bao giờ rẽ'"/>
    </comp>
    <comp lib="9" loc="(690,290)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Funct3 = 010/011 không phải lệnh branch"/>
    </comp>
    <comp lib="9" loc="(690,500)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: funct3 = 010 hoặc 011 (không có lệnh branch như vậy) -&gt; điều kiện = 0, không rẽ. IsBranch = 0 (lệnh khác) -&gt; branch_taken = 0 dù hai giá trị thế nào."/>
    </comp>
    <comp lib="9" loc="(780,475)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Cách làm: một bộ so sánh không dấu và một có dấu cho ra '=', '&lt;'; cổng NOT cho ra '!=', '&gt;='; multiplexer theo funct3 chọn điều kiện: 000 beq, 001 bne, 100 blt, 101 bge, 110 bltu, 111 bgeu."/>
    </comp>
    <comp lib="9" loc="(800,0)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So sánh không dấu: ra '=' và '&lt;'"/>
    </comp>
    <comp lib="9" loc="(800,10)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Beq/bne cần '=', bltu/bgeu cần '&lt;' không dấu"/>
    </comp>
    <comp lib="9" loc="(805,210)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="NOT: đảo '&lt;' có dấu thành '&gt;='"/>
    </comp>
    <comp lib="9" loc="(805,220)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bge = lớn hơn hoặc bằng"/>
    </comp>
    <comp lib="9" loc="(810,430)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: beq = branch if equal (rẽ nếu bằng); bne = not equal (khác); blt = less than (nhỏ hơn, có dấu); bge = greater or equal (lớn hơn hoặc bằng, có dấu); bltu/bgeu = như blt/bge nhưng không dấu."/>
    </comp>
    <comp lib="9" loc="(885,100)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="NOT: đảo '&lt;' không dấu thành '&gt;='"/>
    </comp>
    <comp lib="9" loc="(885,115)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bgeu = lớn hơn hoặc bằng, không dấu"/>
    </comp>
