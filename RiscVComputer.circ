    <comp lib="9" loc="(285,680)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 0 (số thanh ghi x0)"/>
    </comp>
    <comp lib="9" loc="(285,690)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="X0 luôn bằng 0, không cần forward"/>
    </comp>
    <comp lib="9" loc="(410,1080)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="ĐƠN VỊ CHUYỂN TIẾP (ForwardingUnit) - lấy toán hạng mới nhất cho tầng EX"/>
    </comp>
    <comp lib="9" loc="(450,30)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="ForwardingUnit"/>
    </comp>
    <comp lib="9" loc="(450,60)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Pipeline data hazards: take an operand of the EX stage from a later stage instead of the register file."/>
    </comp>
    <comp lib="9" loc="(500,100)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_mem có phải x0 không"/>
    </comp>
    <comp lib="9" loc="(500,110)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ghi vào x0 vô nghĩa nên không forward"/>
    </comp>
    <comp lib="9" loc="(500,220)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_wb có phải x0 không"/>
    </comp>
    <comp lib="9" loc="(500,230)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ghi vào x0 vô nghĩa nên không forward"/>
    </comp>
    <comp lib="9" loc="(500,520)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_wb có bằng rs1_ex không"/>
    </comp>
    <comp lib="9" loc="(500,530)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh ở EX đang cần đúng thanh ghi WB sắp ghi"/>
    </comp>
    <comp lib="9" loc="(500,880)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_wb có bằng rs2_ex không"/>
    </comp>
    <comp lib="9" loc="(500,890)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh ở EX đang cần đúng thanh ghi WB sắp ghi"/>
    </comp>
    <comp lib="9" loc="(520,410)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="operand A (rs1): EX/MEM has priority over MEM/WB"/>
    </comp>
    <comp lib="9" loc="(520,760)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="operand B (rs2)"/>
    </comp>
    <comp lib="9" loc="(570,1130)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Vấn đề: lệnh trước chưa kịp ghi vào register file thì lệnh sau đã cần dùng giá trị đó (phụ thuộc dữ liệu, RAW = Read After Write)."/>
    </comp>
    <comp lib="9" loc="(580,480)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_mem có bằng rs1_ex không"/>
    </comp>
    <comp lib="9" loc="(580,490)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh ở EX đang cần đúng thanh ghi MEM sắp ghi"/>
    </comp>
    <comp lib="9" loc="(580,840)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_mem có bằng rs2_ex không"/>
    </comp>
    <comp lib="9" loc="(580,850)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh ở EX đang cần đúng thanh ghi MEM sắp ghi"/>
    </comp>
    <comp lib="9" loc="(630,1180)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Forward = 10: lấy từ EX/MEM (lệnh ngay trước). Forward = 01: lấy từ MEM/WB (lệnh cách một). Forward = 00: lấy từ register file (không phụ thuộc)."/>
    </comp>
    <comp lib="9" loc="(690,1110)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: forwarding = chuyển tiếp (bypass): đưa kết quả từ tầng sau về tầng EX mà không chờ ghi vào thanh ghi. EX/MEM, MEM/WB = thanh ghi pipeline giữa các tầng."/>
    </comp>
    <comp lib="9" loc="(700,1155)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Vào: rs1_ex, rs2_ex (thanh ghi lệnh ở EX cần đọc), rd_mem/RegWrite_mem (đích của lệnh ở MEM), rd_wb/RegWrite_wb (đích của lệnh ở WB). Ra: ForwardA, ForwardB (2 bit)."/>
    </comp>
    <comp lib="9" loc="(710,1230)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Lưu ý: giá trị lấy từ EX/MEM là kết quả ALU, riêng jal/jalr là PC+4. Phụ thuộc vào lệnh load ngay trước không giải quyết được bằng forwarding -&gt; cần stall (HazardUnit)."/>
    </comp>
    <comp lib="9" loc="(750,40)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="a stage can forward only if it writes a register other than x0"/>
    </comp>
    <comp lib="9" loc="(760,1205)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: cả hai tầng cùng ghi thanh ghi mà EX cần -&gt; ưu tiên EX/MEM vì mới hơn. rd = 0 (x0) -&gt; không forward, vì x0 luôn bằng 0. RegWrite = 0 (store, branch) -&gt; không forward."/>
    </comp>
    <comp lib="9" loc="(835,605)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="AND: WB cũng khớp toán hạng A"/>
    </comp>
    <comp lib="9" loc="(835,615)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ứng viên forward từ MEM/WB"/>
    </comp>
    <comp lib="9" loc="(835,965)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="AND: WB cũng khớp toán hạng B"/>
    </comp>
    <comp lib="9" loc="(835,975)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ứng viên forward từ MEM/WB"/>
    </comp>
    <comp lib="9" loc="(875,485)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="AND: forward toán hạng A từ EX/MEM"/>
    </comp>
    <comp lib="9" loc="(875,495)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh ngay trước có kết quả mới nhất"/>
    </comp>
    <comp lib="9" loc="(875,845)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="AND: forward toán hạng B từ EX/MEM"/>
    </comp>
    <comp lib="9" loc="(875,855)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh ngay trước có kết quả mới nhất"/>
    </comp>
    <comp lib="9" loc="(995,185)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="AND: lệnh ở MEM có ghi thanh ghi và rd khác x0"/>
    </comp>
    <comp lib="9" loc="(995,195)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chỉ khi đó kết quả của nó đáng forward"/>
    </comp>
    <comp lib="9" loc="(995,305)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="AND: lệnh ở WB có ghi thanh ghi và rd khác x0"/>
    </comp>
    <comp lib="9" loc="(995,315)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chỉ khi đó kết quả của nó đáng forward"/>
    </comp>
