    <comp lib="9" loc="(910,1260)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: ALU = Arithmetic Logic Unit (khối số học - logic); ALUCtrl = mã chọn phép tính của ALU."/>
    </comp>
    <comp lib="9" loc="(950,395)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="ALUControl"/>
    </comp>
    <comp lib="9" loc="(950,415)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALUOp 00 = ADD (load/store)   01 = SUB (branch)   10 = R-type   11 = I-type"/>
    </comp>
    <comp lib="9" loc="(950,430)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="R-type and I-type pick the operation from funct3 (funct7 separates ADD/SUB and SRL/SRA)."/>
    </comp>
    <comp lib="9" loc="(975,450)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 2:1 theo funct7[5]: ADD/SUB hoặc SRL/SRA"/>
