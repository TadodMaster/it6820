    </comp>
    <comp lib="9" loc="(500,110)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="InstructionDecode"/>
    </comp>
    <comp lib="9" loc="(500,130)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Pure wiring (one splitter): cuts the 32-bit instruction into its RISC-V fields."/>
    </comp>
    <comp lib="9" loc="(500,335)" name="Text">
      <a name="font" val="Monospaced bold 12"/>
      <a name="text" val="Field = instruction bits  -&gt;  used by"/>
    </comp>
    <comp lib="9" loc="(500,355)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode = instr[6:0]  -&gt;  MainControl (what kind of instruction)"/>
    </comp>
    <comp lib="9" loc="(500,370)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="rd = instr[11:7]  -&gt;  RegisterFile write address"/>
    </comp>
    <comp lib="9" loc="(500,390)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="funct3 = instr[14:12]  -&gt;  ALUControl, BranchUnit, Memory"/>
    </comp>
    <comp lib="9" loc="(500,405)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="rs1 = instr[19:15]  -&gt;  RegisterFile read address 1"/>
    </comp>
    <comp lib="9" loc="(500,425)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="rs2 = instr[24:20]  -&gt;  RegisterFile read address 2"/>
    </comp>
    <comp lib="9" loc="(500,445)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="funct7 = instr[31:25]  -&gt;  ALUControl (ADD vs SUB, SRL vs SRA)"/>
    </comp>
    <comp lib="9" loc="(500,60)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Splitter 32 -&gt; 6 phần: opcode, rd, funct3, rs1, rs2, funct7"/>
    </comp>
    <comp lib="9" loc="(500,70)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Các trường nằm cố định trong lệnh nên chỉ cần đi dây"/>
    </comp>
    <comp lib="9" loc="(630,550)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="GIẢI MÃ LỆNH (InstructionDecode) - cắt lệnh 32 bit thành các trường"/>
    </comp>
    <comp lib="9" loc="(700,625)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode = bit 6..0 (7 bit): cho biết lệnh thuộc nhóm nào (cộng trừ, load, store, rẽ nhánh, nhảy...)."/>
    </comp>
    <comp lib="9" loc="(770,600)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Mục đích: tách các trường của lệnh RISC-V ra thành các dây riêng để các khối sau dùng (đọc thanh ghi, điều khiển, ALU)."/>
    </comp>
    <comp lib="9" loc="(770,720)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Không có cổng logic: RISC-V đặt các trường ở vị trí cố định, nên giải mã chỉ là đi dây (một splitter), rất nhanh và rẻ."/>
    </comp>
    <comp lib="9" loc="(830,675)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="rs1 = bit 19..15, rs2 = bit 24..20 (5 bit mỗi trường): số thanh ghi cần đọc.   funct7 = bit 31..25 (7 bit): phân biệt ADD/SUB, SRL/SRA."/>
    </comp>
    <comp lib="9" loc="(830,700)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: lệnh kiểu U (lui, auipc) và J (jal) không có rs1/rs2/funct3 thật; các bit đó vẫn được cắt ra nhưng các khối sau bỏ qua."/>
    </comp>
    <comp lib="9" loc="(850,650)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="rd = bit 11..7 (5 bit): số thanh ghi sẽ được ghi kết quả (x0..x31).   funct3 = bit 14..12 (3 bit): chọn biến thể trong nhóm (vd beq/bne/blt)."/>
    </comp>
    <comp lib="9" loc="(860,580)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: opcode = Operation Code (mã thao tác); rd = Destination Register (thanh ghi đích); rs1, rs2 = Source Register 1, 2 (thanh ghi nguồn)."/>
    </comp>
