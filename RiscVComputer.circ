      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="MainControl"/>
    </comp>
    <comp lib="9" loc="(620,60)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Compares opcode with each instruction class (left) and combines the flags into control signals (right)."/>
    </comp>
    <comp lib="9" loc="(400,100)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x33 = R-type"/>
    </comp>
    <comp lib="9" loc="(400,190)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x13 = I-type ALU"/>
    </comp>
    <comp lib="9" loc="(400,280)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x03 = load"/>
    </comp>
    <comp lib="9" loc="(400,370)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x23 = store"/>
    </comp>
    <comp lib="9" loc="(400,450)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x63 = branch"/>
    </comp>
    <comp lib="9" loc="(400,540)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x37 = LUI"/>
    </comp>
    <comp lib="9" loc="(400,630)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x17 = AUIPC"/>
    </comp>
    <comp lib="9" loc="(400,720)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x6F = JAL"/>
    </comp>
    <comp lib="9" loc="(400,810)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x67 = JALR"/>
    </comp>
    <comp lib="9" loc="(1300,80)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RegWrite: every class that writes rd"/>
    </comp>
    <comp lib="9" loc="(1300,360)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALUSrc = 1: ALU operand B is the immediate"/>
    </comp>
    <comp lib="9" loc="(1300,700)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALUOp: 00 add (load/store/LUI/AUIPC/jumps)  01 sub (branch)  10 R-type  11 I-type"/>
    </comp>
    <comp lib="9" loc="(1300,990)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ImmSel: 000 I   001 S (store)   010 B (branch)   011 U (LUI, AUIPC)   100 J (JAL)"/>
    </comp>
    <comp lib="9" loc="(1300,1320)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ASel (ALU operand A): 00 rs1   01 PC (AUIPC)   10 zero (LUI)"/>
    </comp>
    <comp lib="9" loc="(1300,1470)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="WBSel (value written to rd): 00 ALU result   01 memory   10 PC + 4 (JAL, JALR)"/>
    </comp>
