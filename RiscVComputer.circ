      <a name="text" val="ALUCtrl: mã phép ALU (0 ADD, 1 SUB,"/>
    </comp>
    <comp lib="9" loc="(2370,1760)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="2 AND, 3 OR, 4 XOR, 5 SLL, 6 SRL, 7 SRA...)"/>
    </comp>
    <comp lib="9" loc="(2370,1920)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="mem_rdata: dữ liệu đọc từ RAM"/>
    </comp>
    <comp lib="9" loc="(2370,1940)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(chỉ có nghĩa với lệnh load)"/>
    </comp>
    <comp lib="9" loc="(2390,210)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux chọn toán hạng A của ALU theo ASel"/>
    </comp>
    <comp lib="9" loc="(2390,220)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="00 rs1, 01 PC (auipc), 10 số 0 (lui)"/>
    </comp>
    <comp lib="9" loc="(2390,230)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lui và auipc dùng lại ALU thay vì thêm phần cứng"/>
    </comp>
    <comp lib="9" loc="(2460,1050)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="BranchUnit: quyết định branch có rẽ không"/>
    </comp>
    <comp lib="9" loc="(2460,1065)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So rs1 với rs2 theo funct3 (beq, bne, blt...)"/>
    </comp>
    <comp lib="9" loc="(2460,860)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ALU: tính kết quả theo mã ALUCtrl"/>
    </comp>
    <comp lib="9" loc="(2460,875)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Một khối chung cho cộng, logic, dịch, so sánh"/>
    </comp>
    <comp lib="9" loc="(2480,1170)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="take_target = branch taken OR JAL"/>
    </comp>
    <comp lib="9" loc="(2480,1360)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="IsJALR selects the register jump"/>
    </comp>
    <comp lib="9" loc="(2480,610)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALUControl"/>
    </comp>
    <comp lib="9" loc="(2480,750)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALU"/>
    </comp>
    <comp lib="9" loc="(2480,920)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="BranchUnit (beq bne blt bge bltu bgeu)"/>
    </comp>
    <comp lib="9" loc="(260,550)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Xung nhịp (Clock): 0 -&gt; 1 -&gt; 0"/>
    </comp>
    <comp lib="9" loc="(260,560)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bấm Ctrl+F9 = một chu kỳ"/>
    </comp>
    <comp lib="9" loc="(260,570)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mọi thanh ghi đổi trạng thái theo xung này"/>
    </comp>
    <comp lib="9" loc="(2605,1210)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux: PC+4 (0) hay PC+imm (1) theo take_target"/>
    </comp>
    <comp lib="9" loc="(2605,1220)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chọn giữa chạy tuần tự và rẽ nhánh/jal"/>
    </comp>
    <comp lib="9" loc="(2660,720)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ALUControl: đổi ALUOp + funct3/7 thành ALUCtrl"/>
    </comp>
    <comp lib="9" loc="(2660,735)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Tách bảng mã ALU khỏi MainControl cho gọn"/>
    </comp>
    <comp lib="9" loc="(270,630)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Clock: Ctrl+F9 = 1 full cycle"/>
    </comp>
    <comp lib="9" loc="(280,700)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RESET = 1 holds PC at 0"/>
    </comp>
    <comp lib="9" loc="(2805,1360)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux: pc_a (0) hay đích jalr (1) theo IsJALR"/>
    </comp>
    <comp lib="9" loc="(2805,1370)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Jalr có đích tính bằng ALU, ưu tiên cao nhất"/>
    </comp>
    <comp lib="9" loc="(2970,1560)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="wb_data: giá trị ghi vào thanh ghi rd"/>
    </comp>
    <comp lib="9" loc="(2970,1580)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ở cuối chu kỳ (write-back)"/>
    </comp>
    <comp lib="9" loc="(2970,1740)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="WBSel: 00 ALU, 01 bộ nhớ,"/>
    </comp>
    <comp lib="9" loc="(2970,1760)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="10 PC+4 (JAL/JALR)"/>
    </comp>
    <comp lib="9" loc="(2970,1920)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="next_pc: địa chỉ lệnh kế tiếp"/>
    </comp>
    <comp lib="9" loc="(2970,1940)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(PC+4, đích rẽ nhánh hoặc JALR)"/>
    </comp>
    <comp lib="9" loc="(3090,410)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Memory: RAM dữ liệu, load/store byte, nửa từ, từ"/>
    </comp>
    <comp lib="9" loc="(3090,425)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh load/store là nơi duy nhất đụng RAM"/>
    </comp>
    <comp lib="9" loc="(3100,260)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Memory (lb lh lw lbu lhu sb sh sw)"/>
    </comp>
    <comp lib="9" loc="(3110,70)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="MEM - Data Memory"/>
    </comp>
    <comp lib="9" loc="(3490,410)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="WBSel: 00 ALU   01 memory   10 PC+4 (JAL/JALR)"/>
    </comp>
    <comp lib="9" loc="(350,2250)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Có mạch này: là CPU đơn giản nhất để hiểu; mạch pipeline dùng lại cùng các khối."/>
    </comp>
    <comp lib="9" loc="(3750,70)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="WB - Write Back"/>
    </comp>
    <comp lib="9" loc="(3780,430)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux chọn giá trị ghi vào rd theo WBSel"/>
    </comp>
    <comp lib="9" loc="(3780,440)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="00 ALU, 01 RAM (load), 10 PC+4 (jal/jalr)"/>
    </comp>
    <comp lib="9" loc="(3780,450)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mỗi loại lệnh lấy kết quả từ nguồn khác nhau"/>
    </comp>
    <comp lib="9" loc="(380,330)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 1 (cho phép ghi PC mọi chu kỳ)"/>
    </comp>
    <comp lib="9" loc="(380,340)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="CPU single-cycle không bao giờ dừng PC"/>
    </comp>
    <comp lib="9" loc="(390,2080)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="CPU SINGLE-CYCLE (main) - mỗi lệnh chạy trọn vẹn trong MỘT chu kỳ xung nhịp"/>
    </comp>
    <comp lib="9" loc="(450,1500)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="BẢNG THEO DÕI (probe): xem các giá trị này sau mỗi lần bấm Ctrl+F9"/>
    </comp>
    <comp lib="9" loc="(450,1690)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="PROBE ĐIỀU KHIỂN (MainControl): lệnh đang chạy bật những tín hiệu nào"/>
    </comp>
    <comp lib="9" loc="(450,1870)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="PROBE DỮ LIỆU: các giá trị chạy trong datapath"/>
    </comp>
    <comp lib="9" loc="(485,480)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 4"/>
    </comp>
    <comp lib="9" loc="(485,490)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mỗi lệnh dài 4 byte, PC+4 là lệnh kế tiếp"/>
    </comp>
    <comp lib="9" loc="(500,170)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC register"/>
    </comp>
    <comp lib="9" loc="(520,70)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="IF - Instruction Fetch"/>
    </comp>
    <comp lib="9" loc="(570,1560)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC: địa chỉ lệnh đang được nạp"/>
    </comp>
    <comp lib="9" loc="(570,1580)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="(tăng 4 mỗi chu kỳ, nhảy khi rẽ nhánh)"/>
    </comp>
    <comp lib="9" loc="(570,1740)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RegWrite = 1: lệnh sẽ ghi"/>
    </comp>
    <comp lib="9" loc="(570,1760)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="vào thanh ghi rd"/>
    </comp>
    <comp lib="9" loc="(570,1920)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="rs1_data: giá trị thanh ghi rs1"/>
    </comp>
    <comp lib="9" loc="(570,1940)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="đọc từ register file"/>
    </comp>
    <comp lib="9" loc="(570,2180)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC kế tiếp: lệnh thường -&gt; PC + 4. branch được rẽ hoặc jal -&gt; PC + hằng số (PC + imm). jalr -&gt; (rs1 + imm) với bit 0 bị xóa (AND 0xFFFFFFFE)."/>
    </comp>
    <comp lib="9" loc="(630,2110)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="BẢNG VIẾT TẮT: PC = Program Counter (bộ đếm chương trình: địa chỉ lệnh đang chạy). ROM = Read Only Memory (bộ nhớ lệnh chỉ đọc). RAM = bộ nhớ dữ liệu đọc/ghi."/>
    </comp>
    <comp lib="9" loc="(670,2230)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RESET = 1 giữ PC ở 0. Ctrl+F9 = một chu kỳ = một lệnh. Các probe ở trên cho thấy lệnh sắp chạy và kết quả của nó; tab State cho thấy giá trị thanh ghi sau khi lệnh xong."/>
    </comp>
    <comp lib="9" loc="(690,160)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lấy PC[9:2] làm địa chỉ từ của ROM"/>
    </comp>
    <comp lib="9" loc="(690,170)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh dài 4 byte nên 2 bit thấp luôn 0"/>
    </comp>
    <comp lib="9" loc="(720,2155)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RISC-V RV32I = tập lệnh cơ sở 32 bit số nguyên. imm = hằng số trong lệnh. rd/rs1/rs2 = thanh ghi đích/nguồn 1/nguồn 2. funct3/funct7 = trường chọn biến thể lệnh. NOP = không làm gì."/>
    </comp>
    <comp lib="9" loc="(720,330)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC[9:2] = word address"/>
    </comp>
    <comp lib="9" loc="(750,420)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC + 4"/>
    </comp>
    <comp lib="9" loc="(770,2130)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="IF = Instruction Fetch (nạp lệnh). ID = Instruction Decode (giải mã, đọc thanh ghi). EX = Execute (thực thi ở ALU). MEM = Memory access (truy cập RAM). WB = Write Back (ghi kết quả vào thanh ghi)."/>
    </comp>
    <comp lib="9" loc="(810,2205)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp theo lệnh: R (add...) ghi ALU vào rd. I (addi...) dùng imm. load: ALU tính địa chỉ, ghi dữ liệu RAM vào rd. store: ghi rs2 vào RAM. branch: so rs1, rs2. lui/auipc/jal/jalr dùng ASel và WBSel."/>
    </comp>
    <comp lib="9" loc="(840,550)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Instruction ROM 256 x 32"/>
    </comp>
    <comp lib="9" loc="(870,720)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ROM lệnh 256 x 32: trả mã máy tại địa chỉ PC"/>
    </comp>
    <comp lib="9" loc="(870,730)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chương trình nằm sẵn trong ROM (kiểu Harvard)"/>
    </comp>
    <comp lib="9" loc="(930,490)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bộ cộng PC + 4: địa chỉ lệnh kế tiếp"/>
    </comp>
    <comp lib="9" loc="(930,500)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh thường chạy tuần tự; jal/jalr cũng lưu PC+4 làm địa chỉ trả về"/>
    </comp>
