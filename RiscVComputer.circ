    <comp lib="9" loc="(1035,265)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="AND: load ở EX và rd khác x0 và có người dùng"/>
    </comp>
    <comp lib="9" loc="(1035,275)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1: dừng PC, IF/ID một chu kỳ, chèn bubble"/>
    </comp>
    <comp lib="9" loc="(1035,290)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Forwarding không cứu được load-use"/>
    </comp>
    <comp lib="9" loc="(245,450)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 0 (số thanh ghi x0)"/>
    </comp>
    <comp lib="9" loc="(245,460)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Load vào x0 không gây phụ thuộc thật"/>
    </comp>
    <comp lib="9" loc="(390,20)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="HazardUnit"/>
    </comp>
    <comp lib="9" loc="(390,40)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Load-use hazard: the instruction in ID needs a value that the load in EX has not read from memory yet -&gt; stall 1 cycle."/>
    </comp>
    <comp lib="9" loc="(410,670)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="stall = (lệnh ở EX là load) VÀ (rd_ex khác x0) VÀ (rd_ex = rs1_id HOẶC rd_ex = rs2_id)."/>
    </comp>
    <comp lib="9" loc="(440,180)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_ex có bằng rs1_id không"/>
    </comp>
    <comp lib="9" loc="(440,190)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh ở ID cần thanh ghi mà load đang đọc"/>
    </comp>
    <comp lib="9" loc="(440,290)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_ex có bằng rs2_id không"/>
    </comp>
    <comp lib="9" loc="(440,300)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh ở ID cần thanh ghi mà load đang đọc"/>
    </comp>
    <comp lib="9" loc="(440,80)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="rd_ex có phải x0 không"/>
    </comp>
    <comp lib="9" loc="(440,90)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Load vào x0 không cần stall"/>
    </comp>
    <comp lib="9" loc="(450,570)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="ĐƠN VỊ HAZARD (HazardUnit) - phát hiện 'load-use' và yêu cầu dừng pipeline (stall)"/>
    </comp>
    <comp lib="9" loc="(540,620)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Vấn đề: lệnh load chỉ có dữ liệu ở cuối tầng MEM, nên lệnh liền sau cần nó ở EX sẽ chậm một nhịp; forwarding không cứu được."/>
    </comp>
    <comp lib="9" loc="(560,720)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: load rồi một lệnh không liên quan rồi mới dùng -&gt; không stall. rd_ex = x0 -&gt; không stall. Chi phí: đúng 1 chu kỳ."/>
    </comp>
    <comp lib="9" loc="(590,645)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Vào: MemRead_ex, rd_ex (lệnh ở EX có phải load và đích là gì), rs1_id, rs2_id (thanh ghi nguồn của lệnh ở ID). Ra: stall = 1 nếu cần dừng."/>
    </comp>
    <comp lib="9" loc="(645,105)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chỉ khi đích thật mới có phụ thuộc"/>
    </comp>
    <comp lib="9" loc="(645,90)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="NOT: rd_ex khác x0"/>
    </comp>
    <comp lib="9" loc="(670,695)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Khi stall = 1: PC và thanh ghi IF/ID giữ nguyên (run = 0), còn từ điều khiển đưa vào ID/EX bị xóa thành 0 (bubble); chu kỳ sau forwarding lấy dữ liệu từ MEM/WB."/>
    </comp>
    <comp lib="9" loc="(690,600)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: hazard = rủi ro/xung đột trong pipeline; load-use = lệnh dùng ngay giá trị vừa load; stall = dừng một chu kỳ; bubble = 'bong bóng' (lệnh rỗng NOP chèn vào)."/>
    </comp>
    <comp lib="9" loc="(755,325)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="OR: lệnh ở ID dùng rs1 hoặc rs2 của load"/>
    </comp>
    <comp lib="9" loc="(755,335)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chỉ cần một trong hai khớp"/>
    </comp>
    <comp lib="9" loc="(780,170)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="rd of the load matches a source of the next instruction"/>
    </comp>
    <comp lib="9" loc="(940,140)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="stall = load in EX AND rd != x0 AND (rd == rs1 OR rd == rs2)"/>
    </comp>
