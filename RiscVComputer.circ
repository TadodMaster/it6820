      <a name="text" val="RegisterFile"/>
    </comp>
    <comp lib="9" loc="(2100,220)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALU operand A: 00 rs1   01 PC (auipc)   10 zero (lui)"/>
    </comp>
    <comp lib="9" loc="(2100,430)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALU operand B: 0 rs2   1 imm"/>
