    </comp>
    <comp lib="9" loc="(-180,230)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bấm Ctrl+F9 = một chu kỳ"/>
    </comp>
    <comp lib="9" loc="(-180,240)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mọi thanh ghi đổi trạng thái theo xung này"/>
    </comp>
    <comp lib="9" loc="(105,810)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 0 (32 bit)"/>
    </comp>
    <comp lib="9" loc="(105,820)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Để nhận ra jal có hằng số bằng 0 (nhảy về chính nó)"/>
    </comp>
    <comp lib="9" loc="(110,320)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Clock: Ctrl+F9 = 1 full cycle"/>
    </comp>
    <comp lib="9" loc="(110,590)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="CLK_n: the register file writes on the falling edge,"/>
    </comp>
    <comp lib="9" loc="(110,620)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="so WB can write and ID can read in the same cycle"/>
    </comp>
    <comp lib="9" loc="(1100,510)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC + 4"/>
    </comp>
    <comp lib="9" loc="(1105,1020)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux: PC+4 (0) hay đích nhảy từ EX (1) theo pc_src_ex"/>
    </comp>
    <comp lib="9" loc="(1105,1030)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Branch/jal/jalr được quyết định ở EX"/>
    </comp>
    <comp lib="9" loc="(1105,1190)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux: lệnh vừa nạp (0) hay 0 = NOP (1) theo pc_src_ex"/>
    </comp>
    <comp lib="9" loc="(1105,1200)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Khi rẽ nhánh, lệnh nạp nhầm phải bị hủy (flush)"/>
    </comp>
    <comp lib="9" loc="(1105,1360)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="NOT: run = không stall"/>
    </comp>
    <comp lib="9" loc="(1105,1370)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="run = 0 thì PC và IF/ID đứng yên"/>
    </comp>
    <comp lib="9" loc="(1105,1385)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Giữ lệnh trong ID khi phải chờ load"/>
    </comp>
    <comp lib="9" loc="(1130,220)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lấy PC[9:2] làm địa chỉ từ của ROM"/>
    </comp>
    <comp lib="9" loc="(1130,230)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lệnh dài 4 byte nên 2 bit thấp luôn 0"/>
    </comp>
    <comp lib="9" loc="(1180,580)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
