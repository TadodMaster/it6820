      <a name="text" val="Tách địa chỉ: byte trong từ và chỉ số từ"/>
    </comp>
    <comp lib="9" loc="(-190,125)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Address[1:0] chọn byte, Address[9:2] chọn từ"/>
    </comp>
    <comp lib="9" loc="(-190,135)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="RAM đánh địa chỉ theo từ"/>
    </comp>
    <comp lib="9" loc="(140,0)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Address[1:0] = byte in the word, Address[9:2] = word index"/>
    </comp>
    <comp lib="9" loc="(390,710)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="BỘ NHỚ DỮ LIỆU (Memory) - RAM 256 từ x 32 bit cùng LoadExtract và StoreMerge"/>
    </comp>
    <comp lib="9" loc="(400,-20)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Data RAM 256 x 32 with asynchronous read.  Loads: lb lh lw lbu lhu.  Stores: sb sh sw (read-modify-write of one word)."/>
    </comp>
    <comp lib="9" loc="(400,10)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="Memory"/>
    </comp>
    <comp lib="9" loc="(500,120)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RAM: writes on the clock edge when MemWrite = 1"/>
    </comp>
    <comp lib="9" loc="(550,835)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RAM đọc bất đồng bộ: RAM đọc đồng bộ chỉ trả dữ liệu sau cạnh xung kế tiếp; khi đó load trả dữ liệu không xác định (lỗi đã gặp và sửa)."/>
    </comp>
    <comp lib="9" loc="(570,740)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: RAM = Random Access Memory (bộ nhớ đọc ghi, mất dữ liệu khi tắt). Address[9:2] = chỉ số từ (0..255), Address[1:0] = byte trong từ."/>
    </comp>
    <comp lib="9" loc="(590,785)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Đọc: bất đồng bộ - địa chỉ vừa đổi là dữ liệu ra ngay trong cùng chu kỳ (lệnh load cần vậy). Ghi: chỉ khi MemWrite = 1, ở cạnh lên của xung nhịp."/>
    </comp>
    <comp lib="9" loc="(680,810)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: lệnh không phải load/store -&gt; MemWrite = 0 nên RAM không đổi; read_data vẫn có giá trị nhưng bị bỏ qua. Địa chỉ &gt;= 1 KiB quấn vòng (chỉ dùng Address[9:2])."/>
    </comp>
    <comp lib="9" loc="(690,760)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Vào: Address (địa chỉ từ ALU), write_data (dữ liệu của lệnh store), MemWrite (cho phép ghi), CLK (xung nhịp), funct3 (loại load/store). Ra: read_data (dữ liệu cho lệnh load)."/>
    </comp>
    <comp lib="9" loc="(750,430)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="StoreMerge: ghép byte mới vào từ cũ"/>
    </comp>
    <comp lib="9" loc="(750,445)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="RAM chỉ ghi nguyên từ nên sb/sh phải đọc-sửa-ghi"/>
    </comp>
    <comp lib="9" loc="(750,590)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="LoadExtract: lấy byte/nửa từ ra khỏi từ, mở rộng"/>
    </comp>
    <comp lib="9" loc="(750,605)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="RAM đọc nguyên từ 32 bit"/>
    </comp>
    <comp lib="9" loc="(760,290)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="StoreMerge: new word to write"/>
    </comp>
    <comp lib="9" loc="(760,470)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="LoadExtract: value delivered to the CPU"/>
    </comp>
    <comp lib="9" loc="(920,120)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="RAM 256 x 32: đọc bất đồng bộ, ghi ở cạnh xung khi MemWrite = 1"/>
    </comp>
    <comp lib="9" loc="(920,130)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Load cần dữ liệu ngay trong chu kỳ"/>
    </comp>
