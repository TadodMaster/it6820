      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Làn 1: byte mới (en1=1) hay byte cũ (en1=0)"/>
    </comp>
    <comp lib="9" loc="(1245,230)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chỉ làn được cho phép mới bị ghi đè"/>
    </comp>
    <comp lib="9" loc="(1245,360)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Làn 2: byte mới (en2=1) hay byte cũ (en2=0)"/>
    </comp>
    <comp lib="9" loc="(1245,370)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chỉ làn được cho phép mới bị ghi đè"/>
    </comp>
    <comp lib="9" loc="(1260,80)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="lane i = enable ? new byte : old byte"/>
    </comp>
    <comp lib="9" loc="(1285,490)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Làn 3: byte mới (en3=1) hay byte cũ (en3=0)"/>
    </comp>
    <comp lib="9" loc="(1285,500)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chỉ làn được cho phép mới bị ghi đè"/>
    </comp>
    <comp lib="9" loc="(1545,100)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chỉ làn được cho phép mới bị ghi đè"/>
    </comp>
    <comp lib="9" loc="(1545,90)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Làn 0: byte mới (en0=1) hay byte cũ (en0=0)"/>
    </comp>
    <comp lib="9" loc="(1650,460)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ghép 4 làn thành từ mới 32 bit"/>
    </comp>
    <comp lib="9" loc="(1650,475)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="RAM ghi nguyên từ, đây là từ sẽ được ghi"/>
    </comp>
    <comp lib="9" loc="(210,350)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lấy size = funct3[1:0]"/>
    </comp>
    <comp lib="9" loc="(210,360)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="00 byte, 01 nửa từ, 10 từ"/>
    </comp>
    <comp lib="9" loc="(210,370)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Funct3 của store cho biết sb, sh, sw"/>
    </comp>
    <comp lib="9" loc="(280,480)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="size = funct3[1:0]: 00 byte  01 half  10 word"/>
    </comp>
    <comp lib="9" loc="(300,915)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Ví dụ: từ cũ 0x11223344, sb 0xAA vào byte 1 -&gt; từ mới 0x1122AA44."/>
    </comp>
    <comp lib="9" loc="(400,790)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="GHÉP DỮ LIỆU STORE (StoreMerge) - tạo từ mới để ghi vào RAM (đọc - sửa - ghi)"/>
    </comp>
    <comp lib="9" loc="(500,-10)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="A store writes a whole RAM word, so keep the old bytes that are not written: sb, sh, sw."/>
    </comp>
    <comp lib="9" loc="(500,20)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="StoreMerge"/>
    </comp>
    <comp lib="9" loc="(530,840)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Vấn đề: RAM chỉ ghi nguyên từ 32 bit. Nên khi ghi 1 byte phải giữ lại 3 byte cũ: đọc từ cũ, thay đúng làn byte, ghi cả từ trở lại."/>
    </comp>
    <comp lib="9" loc="(550,60)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="source byte for lane 1 / 2 / 3"/>
    </comp>
    <comp lib="9" loc="(580,890)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: sw -&gt; cả 4 làn lấy dữ liệu mới. sb vào byte 1 -&gt; chỉ làn 1 lấy byte thấp của write_data, các làn khác giữ byte cũ. sh -&gt; 2 làn."/>
    </comp>
    <comp lib="9" loc="(620,590)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ghép {size, Address[1:0]} thành 4 bit"/>
    </comp>
    <comp lib="9" loc="(620,605)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Đây là địa chỉ của ROM cho phép byte"/>
    </comp>
    <comp lib="9" loc="(680,820)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: sb = store byte (ghi 1 byte); sh = store halfword (ghi nửa từ); sw = store word (ghi cả từ). size = độ rộng lệnh store (funct3[1:0]): 00 byte, 01 nửa từ, 10 từ."/>
    </comp>
    <comp lib="9" loc="(720,865)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Cách làm: ROM 16 hàng x 4 bit đổi {size, Address[1:0]} thành 4 bit cho phép từng làn byte (byte: 0001 0010 0100 1000, nửa từ: 0011 1100, từ: 1111). Mỗi làn chọn byte mới hoặc byte cũ."/>
    </comp>
    <comp lib="9" loc="(730,170)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux: nguồn byte cho làn 1"/>
    </comp>
    <comp lib="9" loc="(730,180)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="sb lấy byte thấp wd0, sh/sw lấy wd1"/>
    </comp>
    <comp lib="9" loc="(730,195)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Sb luôn lấy byte thấp của dữ liệu"/>
    </comp>
    <comp lib="9" loc="(730,290)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux: nguồn byte cho làn 2"/>
    </comp>
    <comp lib="9" loc="(730,300)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="sw lấy wd2, sb/sh lấy wd0"/>
    </comp>
    <comp lib="9" loc="(730,315)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Làn 2 thuộc nửa từ cao"/>
    </comp>
    <comp lib="9" loc="(730,410)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux: nguồn byte cho làn 3"/>
    </comp>
    <comp lib="9" loc="(730,420)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="sw lấy wd3, sh lấy wd1, sb lấy wd0"/>
    </comp>
    <comp lib="9" loc="(730,435)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Làn 3 thuộc nửa từ cao"/>
    </comp>
    <comp lib="9" loc="(770,480)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="byte enables: row = {size, Address[1:0]}"/>
    </comp>
    <comp lib="9" loc="(770,670)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="byte 0001 0010 0100 1000 | half 0011 0011 1100 1100 | word 1111"/>
    </comp>
    <comp lib="9" loc="(970,410)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Tách 4 bit cho phép thành từng làn"/>
    </comp>
    <comp lib="9" loc="(970,420)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mỗi mux làn cần một bit riêng"/>
    </comp>
