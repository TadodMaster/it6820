    <comp lib="9" loc="(1265,325)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Các lệnh này dùng hằng số imm"/>
    </comp>
    <comp lib="9" loc="(1265,75)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="OR: IsR hoặc IsI hoặc IsLoad"/>
    </comp>
    <comp lib="9" loc="(1265,85)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Nửa đầu của điều kiện RegWrite"/>
    </comp>
    <comp lib="9" loc="(1265,95)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Cổng OR tối đa 3 ngõ, nên chia hai nửa"/>
    </comp>
    <comp lib="9" loc="(1380,1200)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ghép IsLoad, WBSel1 thành bus WBSel"/>
    </comp>
    <comp lib="9" loc="(1380,1215)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="WBSel: 00 ALU, 01 RAM (load), 10 PC+4"/>
    </comp>
    <comp lib="9" loc="(1380,1225)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Load lấy dữ liệu từ RAM"/>
    </comp>
    <comp lib="9" loc="(1380,650)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ghép 2 bit thành bus ALUOp (2 bit)"/>
    </comp>
    <comp lib="9" loc="(1380,665)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ALUControl nhận một bus duy nhất"/>
    </comp>
    <comp lib="9" loc="(1385,465)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="OR: IsLui hoặc IsAuipc hoặc IsJALR"/>
    </comp>
    <comp lib="9" loc="(1385,475)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Nửa sau của điều kiện ALUSrc"/>
    </comp>
    <comp lib="9" loc="(1385,490)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Các lệnh này cũng dùng hằng số imm"/>
    </comp>
    <comp lib="9" loc="(1420,1070)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ghép IsAuipc, IsLui thành bus ASel"/>
    </comp>
    <comp lib="9" loc="(1420,1085)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ASel: 00 rs1, 01 PC (auipc), 10 số 0 (lui)"/>
    </comp>
    <comp lib="9" loc="(1420,1095)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Auipc cần PC, lui cần 0"/>
    </comp>
    <comp lib="9" loc="(1420,910)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Ghép ImmSel0, ImmSel1, IsJAL thành bus 3 bit"/>
    </comp>
    <comp lib="9" loc="(1420,925)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Kiểu J (jal) = 100 nên bit 2 chính là IsJAL"/>
    </comp>
    <comp lib="9" loc="(1705,115)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="RegWrite = nửa đầu hoặc nửa sau hoặc IsJALR"/>
    </comp>
    <comp lib="9" loc="(1705,125)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1: lệnh phải ghi kết quả vào rd"/>
    </comp>
    <comp lib="9" loc="(1705,135)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Store và branch không ghi thanh ghi"/>
    </comp>
    <comp lib="9" loc="(1705,325)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ALUSrc = as_a hoặc as_b"/>
    </comp>
    <comp lib="9" loc="(1705,335)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1: toán hạng B của ALU là hằng số imm"/>
    </comp>
    <comp lib="9" loc="(1705,345)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="R và branch dùng rs2, lệnh còn lại dùng imm"/>
    </comp>
    <comp lib="9" loc="(260,80)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x13 = I-type ALU"/>
    </comp>
    <comp lib="9" loc="(300,250)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x23 = store"/>
    </comp>
    <comp lib="9" loc="(300,390)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x37 = LUI"/>
    </comp>
    <comp lib="9" loc="(300,520)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x6F = JAL"/>
    </comp>
    <comp lib="9" loc="(300,570)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x67 = JALR"/>
    </comp>
    <comp lib="9" loc="(380,110)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x33 = R-type"/>
    </comp>
    <comp lib="9" loc="(380,1330)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="ĐIỀU KHIỂN CHÍNH (MainControl) - từ opcode sinh mọi tín hiệu điều khiển"/>
    </comp>
    <comp lib="9" loc="(380,180)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x03 = load"/>
    </comp>
    <comp lib="9" loc="(380,310)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x63 = branch"/>
    </comp>
    <comp lib="9" loc="(380,440)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="opcode 0x17 = AUIPC"/>
    </comp>
    <comp lib="9" loc="(470,20)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="MainControl"/>
    </comp>
    <comp lib="9" loc="(470,40)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Compares opcode with each instruction class (left) and combines the flags into control signals (right)."/>
    </comp>
    <comp lib="9" loc="(480,1430)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="WBSel (2 bit) = giá trị ghi vào rd: 00 kết quả ALU, 01 dữ liệu RAM (load), 10 PC+4 (jal, jalr = địa chỉ trả về)."/>
    </comp>
    <comp lib="9" loc="(480,640)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So opcode với hằng số 0x67: nhóm jalr (nhảy theo thanh ghi)"/>
    </comp>
    <comp lib="9" loc="(480,650)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 thì cờ IsJALR bật. Mỗi nhóm có opcode riêng"/>
    </comp>
    <comp lib="9" loc="(510,1500)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="So sánh từng opcode: mỗi dòng của bảng opcode hiện ra thành một bộ so sánh, dễ đọc và dễ kiểm tra (tests/maincontrol.vec)."/>
    </comp>
    <comp lib="9" loc="(545,815)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ImmSel bit 0 = IsStore hoặc IsLui hoặc IsAuipc"/>
    </comp>
    <comp lib="9" loc="(545,825)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ImmSel: 000 I, 001 S, 010 B, 011 U, 100 J"/>
    </comp>
    <comp lib="9" loc="(545,840)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bit 0 = 1 cho kiểu S và U"/>
    </comp>
    <comp lib="9" loc="(550,1405)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ImmSel (3 bit) = kiểu hằng số: 000 I, 001 S, 010 B, 011 U, 100 J.   ASel (2 bit) = toán hạng A: 00 rs1, 01 PC (auipc), 10 số 0 (lui)."/>
    </comp>
    <comp lib="9" loc="(590,1360)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: RegWrite = ghi thanh ghi; ALUSrc = nguồn của toán hạng B; MemWrite/MemRead = ghi/đọc RAM; IsBranch/IsJAL/IsJALR = lệnh rẽ nhánh/nhảy."/>
    </comp>
    <comp lib="9" loc="(60,130)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So opcode với hằng số 0x33: nhóm kiểu R (add, sub, and, or, sll...)"/>
    </comp>
    <comp lib="9" loc="(60,140)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 thì cờ IsR bật. Mỗi nhóm có opcode riêng"/>
    </comp>
    <comp lib="9" loc="(60,190)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So opcode với hằng số 0x13: nhóm kiểu I-ALU (addi, andi, slli...)"/>
    </comp>
    <comp lib="9" loc="(60,200)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 thì cờ IsI bật. Mỗi nhóm có opcode riêng"/>
    </comp>
    <comp lib="9" loc="(60,240)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So opcode với hằng số 0x23: nhóm store (sb, sh, sw)"/>
    </comp>
    <comp lib="9" loc="(60,250)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 thì cờ IsStore bật. Mỗi nhóm có opcode riêng"/>
    </comp>
    <comp lib="9" loc="(60,280)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So opcode với hằng số 0x03: nhóm load (lb, lh, lw, lbu, lhu)"/>
    </comp>
    <comp lib="9" loc="(60,290)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 thì cờ IsLoad bật. Mỗi nhóm có opcode riêng"/>
    </comp>
    <comp lib="9" loc="(60,320)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So opcode với hằng số 0x63: nhóm branch (beq, bne, blt, bge...)"/>
    </comp>
    <comp lib="9" loc="(60,330)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 thì cờ IsBranch bật. Mỗi nhóm có opcode riêng"/>
    </comp>
    <comp lib="9" loc="(60,410)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So opcode với hằng số 0x17: nhóm auipc (PC + hằng số 20 bit cao)"/>
    </comp>
    <comp lib="9" loc="(60,420)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 thì cờ IsAuipc bật. Mỗi nhóm có opcode riêng"/>
    </comp>
    <comp lib="9" loc="(60,450)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So opcode với hằng số 0x37: nhóm lui (nạp hằng số vào 20 bit cao)"/>
    </comp>
    <comp lib="9" loc="(60,460)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 thì cờ IsLui bật. Mỗi nhóm có opcode riêng"/>
    </comp>
    <comp lib="9" loc="(60,600)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So opcode với hằng số 0x6f: nhóm jal (nhảy và lưu địa chỉ trả về)"/>
    </comp>
    <comp lib="9" loc="(60,610)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1 thì cờ IsJAL bật. Mỗi nhóm có opcode riêng"/>
    </comp>
    <comp lib="9" loc="(610,1480)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: opcode lạ (không thuộc 9 nhóm) -&gt; mọi tín hiệu = 0, lệnh không làm gì (NOP an toàn). store/branch không ghi thanh ghi (RegWrite = 0)."/>
    </comp>
    <comp lib="9" loc="(620,1380)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALUOp (2 bit) = nhóm phép ALU: 00 cộng (load, store, lui, auipc, jalr), 01 trừ (branch), 10 kiểu R, 11 kiểu I (ALUControl chọn tiếp theo funct3/funct7)."/>
    </comp>
    <comp lib="9" loc="(730,1455)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Cách làm: 9 bộ so sánh 7 bit (mỗi opcode một cái) cho ra cờ của từng nhóm lệnh; cổng OR gộp cờ thành tín hiệu: vd RegWrite = R hoặc I hoặc load hoặc lui hoặc auipc hoặc jal hoặc jalr."/>
    </comp>
    <comp lib="9" loc="(890,1050)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="WBSel (value written to rd): 00 ALU result   01 memory   10 PC + 4 (JAL, JALR)"/>
    </comp>
    <comp lib="9" loc="(965,1165)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="WBSel bit 1 = IsJAL hoặc IsJALR"/>
    </comp>
    <comp lib="9" loc="(965,1175)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1: ghi PC+4 (địa chỉ trả về) vào rd"/>
    </comp>
    <comp lib="9" loc="(965,1190)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Jal/jalr lưu địa chỉ quay lại"/>
    </comp>
    <comp lib="9" loc="(965,665)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ALUOp bit 1 = IsR hoặc IsI"/>
    </comp>
    <comp lib="9" loc="(965,675)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="=1: ALUControl phải tra bảng theo funct3/funct7"/>
    </comp>
    <comp lib="9" loc="(965,690)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Các lệnh khác chỉ cần cộng hoặc trừ"/>
    </comp>
    <comp lib="9" loc="(965,895)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="ImmSel bit 1 = IsBranch hoặc IsLui hoặc IsAuipc"/>
    </comp>
    <comp lib="9" loc="(965,905)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bit 1 = 1 cho kiểu B và U"/>
    </comp>
    <comp lib="9" loc="(970,280)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALUSrc = 1: ALU operand B is the immediate"/>
    </comp>
    <comp lib="9" loc="(970,510)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALUOp: 00 add (load/store/LUI/AUIPC/jumps)  01 sub (branch)  10 R-type  11 I-type"/>
    </comp>
    <comp lib="9" loc="(970,60)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RegWrite: every class that writes rd"/>
    </comp>
    <comp lib="9" loc="(970,720)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ImmSel: 000 I   001 S (store)   010 B (branch)   011 U (LUI, AUIPC)   100 J (JAL)"/>
    </comp>
    <comp lib="9" loc="(970,960)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ASel (ALU operand A): 00 rs1   01 PC (AUIPC)   10 zero (LUI)"/>
    </comp>
