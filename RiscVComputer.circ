    </comp>
    <comp lib="9" loc="(1100,130)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mở rộng dấu byte thành 32 bit (lb)"/>
    </comp>
    <comp lib="9" loc="(1100,140)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Byte âm phải giữ giá trị âm (0x80 -&gt; 0xFFFFFF80)"/>
    </comp>
    <comp lib="9" loc="(1100,280)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mở rộng dấu nửa từ thành 32 bit (lh)"/>
    </comp>
    <comp lib="9" loc="(1100,290)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Giữ giá trị âm của số 16 bit"/>
    </comp>
    <comp lib="9" loc="(1350,260)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 8:1: chọn kết quả theo funct3"/>
    </comp>
    <comp lib="9" loc="(1350,270)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="000 lb, 001 lh, 010 lw, 100 lbu, 101 lhu"/>
    </comp>
    <comp lib="9" loc="(1350,285)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Funct3 cho biết loại lệnh load"/>
    </comp>
    <comp lib="9" loc="(260,120)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mở rộng 0 byte thành 32 bit (lbu)"/>
    </comp>
    <comp lib="9" loc="(260,130)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lbu coi byte là số không dấu"/>
    </comp>
    <comp lib="9" loc="(350,-40)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Picks the loaded byte / halfword out of the 32-bit word and extends it: lb lh lw lbu lhu."/>
    </comp>
    <comp lib="9" loc="(390,565)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Cần khối này: RAM của dự án đọc nguyên từ 32 bit, nên việc cắt byte/nửa từ phải làm riêng."/>
    </comp>
    <comp lib="9" loc="(410,440)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="TRÍCH DỮ LIỆU LOAD (LoadExtract) - lấy byte / nửa từ ra khỏi từ 32 bit và mở rộng"/>
    </comp>
    <comp lib="9" loc="(430,-10)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="LoadExtract"/>
    </comp>
    <comp lib="9" loc="(450,515)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="funct3: 000 lb, 001 lh, 010 lw, 100 lbu, 101 lhu. Byte được chọn bằng Address[1:0], nửa từ bằng Address[1]."/>
    </comp>
    <comp lib="9" loc="(500,30)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="byte selected by Address[1:0]"/>
    </comp>
    <comp lib="9" loc="(500,320)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="halfword selected by Address[1]"/>
    </comp>
    <comp lib="9" loc="(520,490)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Vào: dữ liệu cả từ đọc từ RAM, Address[1:0] (byte nào trong từ), funct3 (loại lệnh load). Ra: giá trị 32 bit đưa về thanh ghi."/>
    </comp>
    <comp lib="9" loc="(520,540)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: lb với byte 0x80 -&gt; 0xFFFFFF80 (mở rộng dấu), lbu cùng byte -&gt; 0x00000080. lw lấy nguyên từ, không cần mở rộng."/>
    </comp>
    <comp lib="9" loc="(60,230)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Tách từ 32 bit thành 2 nửa từ"/>
    </comp>
    <comp lib="9" loc="(60,245)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lh/lhu cần lấy riêng một nửa từ"/>
    </comp>
    <comp lib="9" loc="(60,310)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lấy bit 1 của Address[1:0]"/>
    </comp>
    <comp lib="9" loc="(60,325)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Nửa từ chọn bằng bit 1 của địa chỉ"/>
    </comp>
    <comp lib="9" loc="(65,180)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 2:1: chọn nửa từ theo Address[1]"/>
    </comp>
    <comp lib="9" loc="(65,190)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Nửa từ nằm ở 1 trong 2 vị trí của từ"/>
    </comp>
    <comp lib="9" loc="(710,470)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: lb = load byte (nạp 1 byte, mở rộng dấu); lh = load halfword (nửa từ 16 bit, mở rộng dấu); lw = load word (cả từ 32 bit); lbu/lhu = như lb/lh nhưng mở rộng 0 (không dấu)."/>
    </comp>
    <comp lib="9" loc="(760,320)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mở rộng 0 nửa từ thành 32 bit (lhu)"/>
    </comp>
    <comp lib="9" loc="(760,330)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Lhu coi nửa từ là số không dấu"/>
    </comp>
    <comp lib="9" loc="(780,30)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 4:1: chọn byte theo Address[1:0]"/>
    </comp>
    <comp lib="9" loc="(780,40)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Byte nằm ở một trong 4 vị trí của từ"/>
    </comp>
