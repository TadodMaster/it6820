    <comp lib="9" loc="(3510,30)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="RV32I 5-stage pipeline - top level"/>
    </comp>
    <comp lib="9" loc="(3510,50)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="IF &gt; ID &gt; EX &gt; MEM &gt; WB with pipeline registers between the stages.  Forwarding (EX), load-use stall (ID) and branch / jump flush (EX)."/>
    </comp>
    <comp lib="9" loc="(3510,80)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Tunnels with the same name are the same wire.  Suffix _id _ex _mem _wb = the stage a value belongs to."/>
    </comp>
    <comp lib="9" loc="(860,110)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="IF - Instruction Fetch"/>
    </comp>
    <comp lib="9" loc="(2340,110)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="ID - Decode / Register Read"/>
    </comp>
    <comp lib="9" loc="(3820,110)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="EX - Execute"/>
    </comp>
    <comp lib="9" loc="(6300,110)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="MEM - Data Memory"/>
    </comp>
    <comp lib="9" loc="(7520,110)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="WB - Write Back"/>
    </comp>
    <comp lib="9" loc="(1660,140)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="IF/ID registers"/>
    </comp>
    <comp lib="9" loc="(3150,140)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="ID/EX registers"/>
    </comp>
    <comp lib="9" loc="(5620,140)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="EX/MEM registers"/>
    </comp>
    <comp lib="9" loc="(6880,140)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="MEM/WB registers"/>
    </comp>
    <comp lib="9" loc="(110,300)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Clock: Simulate &gt; Tick"/>
    </comp>
    <comp lib="9" loc="(120,420)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RESET = 1 holds PC at 0"/>
    </comp>
    <comp lib="9" loc="(110,620)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="CLK_n: the register file writes on the falling edge,"/>
    </comp>
    <comp lib="9" loc="(110,640)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="so WB can write and ID can read in the same cycle"/>
    </comp>
    <comp lib="9" loc="(750,280)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC register (holds while stalled)"/>
    </comp>
    <comp lib="9" loc="(1100,540)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC + 4"/>
    </comp>
    <comp lib="9" loc="(1220,720)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Instruction ROM 256 x 32"/>
    </comp>
    <comp lib="9" loc="(940,1060)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="next PC: PC+4, or the branch / jump target from EX"/>
    </comp>
    <comp lib="9" loc="(940,1240)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="a taken branch / jump turns the fetched instruction into a bubble (0)"/>
    </comp>
    <comp lib="9" loc="(940,1530)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="run = not stall: PC and IF/ID only advance when run = 1"/>
    </comp>
    <comp lib="9" loc="(2260,240)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="InstructionDecode"/>
    </comp>
    <comp lib="9" loc="(2260,580)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="MainControl"/>
    </comp>
    <comp lib="9" loc="(2260,940)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ImmGen"/>
    </comp>
    <comp lib="9" loc="(2260,1200)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RegisterFile (writes on CLK_n)"/>
    </comp>
    <comp lib="9" loc="(2260,1550)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="HazardUnit: load-use stall"/>
    </comp>
    <comp lib="9" loc="(2220,1710)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="control word (13 bits)"/>
    </comp>
    <comp lib="9" loc="(2220,2360)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="bubble = stall OR flush: the control word becomes 0 (a NOP)"/>
    </comp>
    <comp lib="9" loc="(3670,630)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="control word of the instruction in EX"/>
    </comp>
    <comp lib="9" loc="(4210,320)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ForwardingUnit"/>
    </comp>
    <comp lib="9" loc="(3670,810)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="value in EX/MEM that can be forwarded (ALU result, or PC+4 of JAL/JALR)"/>
    </comp>
    <comp lib="9" loc="(3670,1040)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="operand A: 00 register  01 MEM/WB  10 EX/MEM"/>
    </comp>
    <comp lib="9" loc="(3670,1330)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="operand B / store data: same choices"/>
    </comp>
    <comp lib="9" loc="(3990,1060)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALU A: rs1 / PC (auipc) / 0 (lui)"/>
    </comp>
    <comp lib="9" loc="(3990,1330)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALU B: rs2 / imm"/>
    </comp>
    <comp lib="9" loc="(4590,840)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALUControl"/>
    </comp>
    <comp lib="9" loc="(4590,1090)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALU"/>
    </comp>
    <comp lib="9" loc="(4590,1340)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="BranchUnit"/>
    </comp>
    <comp lib="9" loc="(5000,260)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="branch / JAL target = PC + imm"/>
    </comp>
    <comp lib="9" loc="(5000,440)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="JALR target = (rs1 + imm), bit 0 cleared"/>
    </comp>
    <comp lib="9" loc="(5000,810)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="pc_src_ex = redirect the PC (taken branch, JAL, JALR) and flush IF/ID + ID/EX"/>
    </comp>
    <comp lib="9" loc="(5000,1120)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="link address PC+4"/>
    </comp>
    <comp lib="9" loc="(5260,1800)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="pack RegWrite, MemWrite, MemRead, WBSel"/>
    </comp>
    <comp lib="9" loc="(6150,500)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="control word of the instruction in MEM"/>
    </comp>
    <comp lib="9" loc="(6150,670)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="WBSel bit 1: result is PC+4"/>
    </comp>
    <comp lib="9" loc="(6500,690)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Memory"/>
    </comp>
    <comp lib="9" loc="(6520,1260)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="pack RegWrite, WBSel"/>
    </comp>
    <comp lib="9" loc="(7360,260)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="control word of the instruction in WB"/>
    </comp>
    <comp lib="9" loc="(7520,400)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="WBSel: 00 ALU  01 memory  10 PC+4"/>
    </comp>
    <comp lib="9" loc="(7520,630)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="wb_data goes to the register file (ID) and is also forwarded to EX"/>
    </comp>
