    <comp lib="9" loc="(1300,170)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="RegisterFile"/>
    </comp>
    <comp lib="9" loc="(1300,190)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="32 registers x 32 bits. x0 always loads the constant 0, so it always reads 0."/>
    </comp>
    <comp lib="9" loc="(1300,210)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Write: wb_data goes to every register; the DMX turns on only WE[rd] when write = 1."/>
    </comp>
    <comp lib="9" loc="(1300,225)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Read: two 32:1 multiplexers pick x[rs1] and x[rs2] (asynchronous, no clock needed)."/>
    </comp>
    <comp lib="9" loc="(1370,1405)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Read port 2: x[rs2] -&gt; rs2_data"/>
    </comp>
    <comp lib="9" loc="(1420,850)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 32:1: cổng đọc, chọn thanh ghi theo rs1 hoặc rs2"/>
    </comp>
    <comp lib="9" loc="(1420,860)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Đọc bất đồng bộ để có toán hạng ngay"/>
    </comp>
    <comp lib="9" loc="(1860,860)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Demux 1:32: đưa RegWrite tới thanh ghi số rd"/>
    </comp>
    <comp lib="9" loc="(1860,870)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Chỉ thanh ghi đích được cho phép ghi"/>
    </comp>
    <comp lib="9" loc="(1870,1385)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Write decoder: rd -&gt; WE of one register"/>
    </comp>
    <comp lib="9" loc="(315,250)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Hằng số 0 nối vào x0"/>
    </comp>
    <comp lib="9" loc="(315,265)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="X0 luôn bằng 0, không bao giờ đổi"/>
    </comp>
    <comp lib="9" loc="(450,1510)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="TẬP THANH GHI (RegisterFile) - 32 thanh ghi x0..x31, mỗi thanh ghi 32 bit"/>
    </comp>
    <comp lib="9" loc="(510,1660)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="32 thanh ghi riêng + mux: mỗi thanh ghi là một hộp có nhãn, nhìn thấy được trong tab State của Logisim."/>
    </comp>
    <comp lib="9" loc="(610,1560)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Đọc: hai cổng đọc độc lập (rs1 -&gt; rs1_data, rs2 -&gt; rs2_data), đọc bất đồng bộ (đổi số thanh ghi là giá trị ra ngay, không chờ xung)."/>
    </comp>
    <comp lib="9" loc="(640,1585)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Ghi: nếu write = 1 thì ở cạnh xung nhịp, write_data được ghi vào thanh ghi số rd (bộ DEMUX bật tín hiệu cho phép ghi của đúng một thanh ghi)."/>
    </comp>
    <comp lib="9" loc="(650,1540)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Viết tắt: x0..x31 = 32 thanh ghi của RISC-V; rd = thanh ghi đích; rs1/rs2 = thanh ghi nguồn; write = RegWrite (cho phép ghi); CLK = xung nhịp."/>
    </comp>
    <comp lib="9" loc="(660,1635)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Trong pipeline: khối này nhận xung nhịp ĐẢO (CLK_n) nên ghi ở cạnh xuống: lệnh ở WB ghi nửa đầu chu kỳ, lệnh ở ID đọc nửa sau -&gt; thấy giá trị mới."/>
    </comp>
    <comp lib="9" loc="(680,1395)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Read port 1: x[rs1] -&gt; rs1_data"/>
    </comp>
    <comp lib="9" loc="(690,840)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 32:1: cổng đọc, chọn thanh ghi theo rs1 hoặc rs2"/>
    </comp>
    <comp lib="9" loc="(690,850)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Đọc bất đồng bộ để có toán hạng ngay"/>
    </comp>
    <comp lib="9" loc="(780,1610)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: write = 0 -&gt; không thanh ghi nào đổi (store, branch). rd = 0 -&gt; x0 không đổi, luôn bằng 0 (hằng số 0). Đọc và ghi cùng thanh ghi trong một chu kỳ -&gt; đọc giá trị cũ."/>
    </comp>
