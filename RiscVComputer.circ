    <comp lib="9" loc="(700,1055)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: B và J luôn chẵn (bit 0 = 0) vì lệnh dài 4 byte; U không mở rộng dấu mà chèn 12 bit 0 vào cuối."/>
    </comp>
    <comp lib="9" loc="(700,150)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="ImmGen"/>
    </comp>
    <comp lib="9" loc="(700,170)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Rebuilds the 32-bit immediate from the instruction bits; ImmSel picks the format."/>
    </comp>
    <comp lib="9" loc="(710,450)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bit 0 luôn bằng 0"/>
    </comp>
    <comp lib="9" loc="(710,465)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Đích branch/jal là địa chỉ chẵn"/>
    </comp>
    <comp lib="9" loc="(730,1080)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Xáo bit: để bit dấu luôn ở bit 31 của lệnh và nhiều bit nằm cùng vị trí giữa các kiểu, nên mạch giải mã đơn giản hơn."/>
    </comp>
    <comp lib="9" loc="(740,1030)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Mở rộng dấu (sign extension): bit cao nhất của hằng số được chép vào các bit trên, nên số âm vẫn âm (vd -8 = 0xFFFFFFF8)."/>
    </comp>
    <comp lib="9" loc="(750,110)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bit 0 luôn bằng 0"/>
    </comp>
    <comp lib="9" loc="(750,125)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Đích branch/jal là địa chỉ chẵn"/>
    </comp>
    <comp lib="9" loc="(760,980)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Mục đích: mỗi kiểu lệnh cất hằng số ở chỗ khác nhau và bị xáo bit; khối này gom lại đúng thứ tự rồi mở rộng dấu thành 32 bit."/>
    </comp>
    <comp lib="9" loc="(770,-5)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mở rộng dấu 12 bit thành 32 bit"/>
    </comp>
    <comp lib="9" loc="(770,0)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Số âm phải giữ nguyên giá trị (-8 -&gt; 0xFFFFFFF8)"/>
    </comp>
    <comp lib="9" loc="(770,810)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mở rộng dấu 21 bit thành 32 bit"/>
    </comp>
    <comp lib="9" loc="(770,820)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Số âm phải giữ nguyên giá trị (-8 -&gt; 0xFFFFFFF8)"/>
    </comp>
    <comp lib="9" loc="(850,570)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mở rộng dấu 12 bit thành 32 bit"/>
    </comp>
    <comp lib="9" loc="(850,580)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Số âm phải giữ nguyên giá trị (-8 -&gt; 0xFFFFFFF8)"/>
    </comp>
    <comp lib="9" loc="(920,1005)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ImmSel chọn kiểu: 000 I (addi, load, jalr: 12 bit), 001 S (store: 12 bit), 010 B (branch: 13 bit, bit 0 = 0), 011 U (lui, auipc: imm &lt;&lt; 12), 100 J (jal: 21 bit, bit 0 = 0)."/>
    </comp>
    <comp lib="9" loc="(960,240)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 8:1: chọn kiểu hằng số theo ImmSel"/>
    </comp>
    <comp lib="9" loc="(960,250)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="0 I, 1 S, 2 B, 3 U, 4 J"/>
    </comp>
    <comp lib="9" loc="(960,260)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mỗi nhóm lệnh có kiểu hằng số khác nhau"/>
    </comp>
    <comp lib="9" loc="(980,520)" name="Text">
      <a name="font" val="Monospaced bold 12"/>
      <a name="text" val="ImmSel: 0 I   1 S   2 B   3 U   4 J"/>
    </comp>
    <comp lib="9" loc="(980,540)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="All results are sign-extended to 32 bits."/>
    </comp>
