    <comp lib="9" loc="(1280,20)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="RV32I single-cycle CPU - top level"/>
    </comp>
    <comp lib="9" loc="(1280,40)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="One instruction per clock cycle.  Data flows left to right: IF &gt; ID &gt; EX &gt; MEM &gt; WB.  Tunnels with the same name are the same wire."/>
    </comp>
    <comp lib="9" loc="(520,80)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="IF - Instruction Fetch"/>
    </comp>
    <comp lib="9" loc="(1420,80)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="ID - Decode / Register Read"/>
    </comp>
    <comp lib="9" loc="(2320,80)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="EX - Execute and next PC"/>
    </comp>
    <comp lib="9" loc="(3110,80)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="MEM - Data Memory"/>
    </comp>
    <comp lib="9" loc="(3750,80)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="WB - Write Back"/>
    </comp>
    <comp lib="9" loc="(100,250)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Clock: Simulate &gt; Tick"/>
    </comp>
    <comp lib="9" loc="(110,360)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="RESET = 1 holds PC at 0"/>
    </comp>
    <comp lib="9" loc="(430,230)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC register"/>
    </comp>
    <comp lib="9" loc="(720,350)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC[9:2] = word address"/>
    </comp>
    <comp lib="9" loc="(750,450)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="PC + 4"/>
    </comp>
    <comp lib="9" loc="(840,580)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Instruction ROM 256 x 32"/>
    </comp>
    <comp lib="9" loc="(1390,190)" name="Text">
