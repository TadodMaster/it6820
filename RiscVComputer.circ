    <comp lib="9" loc="(1130,1330)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Kiểu R: funct3 chọn phép; funct7 bit 5 = 1 biến ADD thành SUB và SRL thành SRA. Kiểu I: chỉ lệnh dịch (slli, srli, srai) xét funct7 bit 5; addi bỏ qua funct7."/>
    </comp>
    <comp lib="9" loc="(1130,970)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 8:1: tra bảng mã theo funct3"/>
    </comp>
    <comp lib="9" loc="(1130,980)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Funct3 chọn phép trong nhóm lệnh R hoặc I"/>
    </comp>
    <comp lib="9" loc="(1170,380)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 8:1: tra bảng mã theo funct3"/>
    </comp>
    <comp lib="9" loc="(1170,390)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Funct3 chọn phép trong nhóm lệnh R hoặc I"/>
    </comp>
    <comp lib="9" loc="(1180,1280)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Mã ALUCtrl: 0 ADD (cộng), 1 SUB (trừ), 2 AND, 3 OR, 4 XOR, 5 SLL (dịch trái), 6 SRL (dịch phải logic), 7 SRA (dịch phải số học), 8 SLT (so sánh có dấu), 9 SLTU (không dấu)."/>
    </comp>
    <comp lib="9" loc="(1180,480)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mã ALUCtrl = 1 (SUB)"/>
    </comp>
    <comp lib="9" loc="(1180,495)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mỗi dòng của bảng mã ALU là một hằng số"/>
    </comp>
    <comp lib="9" loc="(1190,1305)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ALUOp = 00 -&gt; luôn ADD (tính địa chỉ load/store, lui, auipc, jalr). ALUOp = 01 -&gt; luôn SUB (so sánh cho branch). ALUOp = 10 -&gt; tra bảng kiểu R. ALUOp = 11 -&gt; tra bảng kiểu I."/>
    </comp>
    <comp lib="9" loc="(1350,700)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 4:1 theo ALUOp: 00 ADD, 01 SUB, 10 bảng R, 11 bảng I"/>
    </comp>
    <comp lib="9" loc="(1350,710)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Load/store/branch không cần tra funct3"/>
