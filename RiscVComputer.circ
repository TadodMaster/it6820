    </comp>
    <comp lib="9" loc="(335,125)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="AND từng bit A và B (ALUCtrl = 2)"/>
    </comp>
    <comp lib="9" loc="(335,135)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="And, andi"/>
    </comp>
    <comp lib="9" loc="(435,735)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="SRA: arithmetic shift right"/>
    </comp>
    <comp lib="9" loc="(435,830)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="SLT"/>
    </comp>
    <comp lib="9" loc="(435,910)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="SLTU"/>
    </comp>
    <comp lib="9" loc="(440,1020)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Dịch phải số học (ALUCtrl = 7, SRA)"/>
    </comp>
    <comp lib="9" loc="(440,1030)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Sra, srai (giữ nguyên bit dấu)"/>
    </comp>
    <comp lib="9" loc="(440,1070)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So sánh có dấu A &lt; B (ALUCtrl = 8, SLT)"/>
    </comp>
    <comp lib="9" loc="(440,1080)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Slt, slti coi số là có dấu"/>
    </comp>
    <comp lib="9" loc="(440,1110)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="So sánh không dấu A &lt; B (ALUCtrl = 9, SLTU)"/>
    </comp>
    <comp lib="9" loc="(440,1120)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Sltu, sltiu coi số là không dấu"/>
    </comp>
    <comp lib="9" loc="(440,555)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="SLL (ctrl 5)"/>
    </comp>
    <comp lib="9" loc="(440,615)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="SRL (ctrl 6)"/>
    </comp>
    <comp lib="9" loc="(440,675)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="SRA (ctrl 7)"/>
    </comp>
    <comp lib="9" loc="(450,195)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="ADD   (ctrl 0)"/>
    </comp>
    <comp lib="9" loc="(450,20)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bộ trừ A - B (ALUCtrl = 1, SUB)"/>
    </comp>
    <comp lib="9" loc="(450,255)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="SUB   (ctrl 1)"/>
    </comp>
    <comp lib="9" loc="(450,30)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Sub và so sánh trong branch cần phép trừ"/>
    </comp>
    <comp lib="9" loc="(450,60)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Bộ cộng A + B (ALUCtrl = 0, ADD)"/>
    </comp>
    <comp lib="9" loc="(450,70)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Add, addi, địa chỉ load/store, jalr đều cần phép cộng"/>
    </comp>
    <comp lib="9" loc="(455,320)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="AND   (ctrl 2)"/>
    </comp>
    <comp lib="9" loc="(455,400)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="OR   (ctrl 3)"/>
    </comp>
    <comp lib="9" loc="(455,480)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="XOR   (ctrl 4)"/>
    </comp>
    <comp lib="9" loc="(470,150)" name="Text">
      <a name="font" val="Monospaced bold 16"/>
      <a name="text" val="ALU"/>
    </comp>
    <comp lib="9" loc="(470,170)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Every operation is computed in parallel; ALU_Ctrl selects which result leaves the ALU."/>
    </comp>
    <comp lib="9" loc="(490,1230)" name="Text">
      <a name="font" val="Monospaced bold 14"/>
      <a name="text" val="ALU (Arithmetic Logic Unit = khối số học - logic) - tính kết quả theo mã ALUCtrl"/>
    </comp>
    <comp lib="9" loc="(510,930)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mở rộng 0 kết quả 1 bit thành 32 bit (0 hoặc 1)"/>
    </comp>
    <comp lib="9" loc="(510,940)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="SLT phải trả đúng 0/1, mở rộng dấu sẽ ra 0xFFFFFFFF (lỗi đã sửa)"/>
    </comp>
    <comp lib="9" loc="(510,970)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mở rộng 0 kết quả 1 bit thành 32 bit (0 hoặc 1)"/>
    </comp>
    <comp lib="9" loc="(510,980)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="SLT phải trả đúng 0/1, mở rộng dấu sẽ ra 0xFFFFFFFF (lỗi đã sửa)"/>
    </comp>
    <comp lib="9" loc="(520,1330)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các lệnh dịch chỉ dùng 5 bit thấp của B (B[4:0], tối đa dịch 31). SRA giữ nguyên bit dấu, SRL chèn bit 0."/>
    </comp>
    <comp lib="9" loc="(530,1260)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Vào: rs1_data = toán hạng A, rs2_data = toán hạng B, ALU_Ctrl = mã phép tính. Ra: result = kết quả 32 bit."/>
    </comp>
    <comp lib="9" loc="(540,1380)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Tính song song rồi chọn: đơn giản, dễ đọc; tốc độ không quan trọng trong Logisim (không mô phỏng độ trễ cổng)."/>
    </comp>
    <comp lib="9" loc="(575,105)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="OR từng bit A và B (ALUCtrl = 3)"/>
    </comp>
    <comp lib="9" loc="(575,115)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Or, ori"/>
    </comp>
    <comp lib="9" loc="(690,190)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mux 16:1: chọn kết quả theo ALU_Ctrl"/>
    </comp>
    <comp lib="9" loc="(690,200)" name="Text">
      <a name="font" val="Monospaced plain 10"/>
      <a name="text" val="Mọi phép tính chạy song song, mux lấy phép cần dùng"/>
    </comp>
    <comp lib="9" loc="(715,690)" name="Text">
      <a name="font" val="Monospaced bold 12"/>
      <a name="text" val="ALU_Ctrl  operation"/>
    </comp>
    <comp lib="9" loc="(715,710)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="0 ADD   1 SUB   2 AND   3 OR   4 XOR"/>
    </comp>
    <comp lib="9" loc="(715,725)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="5 SLL   6 SRL   7 SRA"/>
    </comp>
    <comp lib="9" loc="(715,745)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="8 SLT (signed)   9 SLTU (unsigned)"/>
    </comp>
    <comp lib="9" loc="(720,1305)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="SLT/SLTU = Set Less Than (đặt 1 nếu A &lt; B, ngược lại 0): SLT so sánh có dấu (-1 &lt; 1), SLTU không dấu (0xFFFFFFFF &gt; 1). Kết quả 1 bit được mở rộng 0 thành 32 bit."/>
    </comp>
    <comp lib="9" loc="(780,1280)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Cách làm: mọi phép tính (cộng, trừ, AND, OR, XOR, dịch trái, dịch phải logic, dịch phải số học, SLT, SLTU) chạy song song; một multiplexer 16 ngả chọn một kết quả theo ALU_Ctrl."/>
    </comp>
    <comp lib="9" loc="(840,1355)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="Các trường hợp: tràn số khi cộng/trừ bị bỏ qua (kết quả quấn vòng 32 bit, đúng theo RISC-V). Mã ALU_Ctrl không dùng (10..15) -&gt; kết quả không xác định, không xảy ra vì ALUControl chỉ sinh 0..9."/>
    </comp>
    <comp lib="9" loc="(930,790)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="SLT and SLTU: the 1-bit compare result is zero-extended,"/>
    </comp>
    <comp lib="9" loc="(930,805)" name="Text">
      <a name="font" val="Monospaced plain 12"/>
      <a name="text" val="so the ALU output is 0x00000000 or 0x00000001."/>
    </comp>
